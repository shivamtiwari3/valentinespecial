# ===========================================
# Valentine App - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!

# ----- Supabase Configuration -----
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ----- App Configuration -----
# Your production domain (no trailing slash)
NEXT_PUBLIC_APP_URL=https://valentinespecial.vercel.app

# ----- Email Configuration (Resend) -----
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# ----- Security Configuration -----
# Generate a strong random secret for internal API authentication
# You can use: openssl rand -hex 32
INTERNAL_API_SECRET=your_strong_random_secret_here

# ----- Optional: Rate Limiting (if using Redis) -----
# REDIS_URL=redis://localhost:6379

# ===========================================
# IMPORTANT SECURITY NOTES:
# ===========================================
# 1. Never commit real API keys to git
# 2. In production, use Vercel Environment Variables
# 3. NEXT_PUBLIC_* vars are exposed to the browser
# 4. Keep RESEND_API_KEY and INTERNAL_API_SECRET private
# 5. Rotate keys if you suspect they've been compromised
